<?xml version="1.0" encoding="utf-8"?>
<!--
  Orator mark: a voice radiating outward — a solid centre with two arcs either side.
  Drawn on the 108dp adaptive canvas; everything stays inside the 66dp safe zone
  (21..87) so no launcher mask can clip it. Accent cyan from OnyxTokens.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Centre -->
    <path
        android:fillColor="#2AA198"
        android:pathData="M47,54 a7,7 0 1,0 14,0 a7,7 0 1,0 -14,0 z" />

    <!-- Inner arcs -->
    <path
        android:pathData="M65.6,40.2 A18,18 0 0 1 65.6,67.8"
        android:strokeColor="#2AA198"
        android:strokeWidth="7"
        android:strokeLineCap="round" />
    <path
        android:pathData="M42.4,40.2 A18,18 0 0 0 42.4,67.8"
        android:strokeColor="#2AA198"
        android:strokeWidth="7"
        android:strokeLineCap="round" />

    <!-- Outer arcs -->
    <path
        android:pathData="M72,32.6 A28,28 0 0 1 72,75.4"
        android:strokeColor="#2AA198"
        android:strokeWidth="7"
        android:strokeLineCap="round" />
    <path
        android:pathData="M36,32.6 A28,28 0 0 0 36,75.4"
        android:strokeColor="#2AA198"
        android:strokeWidth="7"
        android:strokeLineCap="round" />
</vector>
